                                        "style": {
                                            "pointSize": 28,
                                            "spacing": {
                                                "leading": 0.95,
                                                "kerning": 0.95
                                            },
                                            "alignment": {
                                                "h": "left",
                                                "v": "center"
                                            },
                                            "options": {
                                                "lineWrap": true,
                                                "newlineHandling": "standard",
                                                "pipeCharacterBehavior": "handle"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "TableRowWidget",
                            "name": "SunderCharmsDropRow",
                            "fields": {
                                "rect": {
                                    "height": 180
                                }
                            },
                            "children": [
                                {
                                    "type": "TextBoxWidget",
                                    "name": "SunderCharmsDropText",
                                    "fields": {
                                        "text": "Drop source: Nightmare and Hell Terror Zones. These charms are part of the TZ-specific loot table and are intended as a farmable upgrade path for removing monster immunities. Magic find does not affect Sunder Charm drop rate.",
                                        "style": {
                                            "pointSize": 28,
                                            "spacing": {
                                                "leading": 0.95,
                                                "kerning": 0.95
                                            },
                                            "alignment": {
                                                "h": "left",
                                                "v": "center"
                                            },
                                            "options": {
                                                "lineWrap": true,
                                                "newlineHandling": "standard",
                                                "pipeCharacterBehavior": "handle"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "TableRowWidget",
                            "name": "SunderCharmsRecipeTitleRow",
                            "children": [
                                {
                                    "type": "TextBoxWidget",
                                    "name": "SunderCharmsRecipeTitleText",
                                    "fields": {
                                        "text": "Crafting Recipes",
                                        "style": "$StyleSettingsTitle"
                                    },
                                    "children": [
                                        {
                                            "type": "ImageWidget",
                                            "name": "SunderCharmsRecipeDivider",
                                            "fields": {
