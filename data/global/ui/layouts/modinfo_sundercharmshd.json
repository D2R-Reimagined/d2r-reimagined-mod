                            "fields": {
                                "rect": {
                                    "height": 420
                                }
                            },
                            "children": [
                                {
                                    "type": "TextBoxWidget",
                                    "name": "SunderCharmsRecipeText",
                                    "fields": {
                                        "text": "Renew and reset recipes:\n\nLatent Flame Rift + Unique Jewel + SUR Rune + Orb of Conversion + Deep Worldstone Shard = Renewed Flame Rift\nLatent Cold Rupture + Unique Jewel + SUR Rune + Orb of Conversion + Eastern Worldstone Shard = Renewed Cold Rupture\nLatent Crack of the Heavens + Unique Jewel + SUR Rune + Orb of Conversion + Southern Worldstone Shard = Renewed Crack of the Heavens\nLatent Rotting Fissure + Unique Jewel + SUR Rune + Orb of Conversion + Western Worldstone Shard = Renewed Rotting Fissure\nLatent Bone Break + Unique Jewel + SUR Rune + Orb of Conversion + Northern Worldstone Shard = Renewed Bone Break\nLatent Black Cleft + Unique Jewel + SUR Rune + Orb of Conversion + Northern Worldstone Shard + Southern Worldstone Shard + Deep Worldstone Shard = Renewed Black Cleft\n\nRenewed Sunder Charm Any Type + HEL Rune + Orb of Conversion = Latent Charm of the same type",
                                        "style": {
                                            "pointSize": 28,
                                            "spacing": {
                                                "leading": 0.95,
                                                "kerning": 0.95
                                            },
                                            "alignment": {
                                                "h": "left",
                                                "v": "center"
                                            },
                                            "options": {
                                                "lineWrap": true,
                                                "newlineHandling": "standard",
                                                "pipeCharacterBehavior": "handle"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
