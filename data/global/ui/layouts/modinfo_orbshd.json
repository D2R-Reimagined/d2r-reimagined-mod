                                        "type": "TextBoxWidget",
                                        "name": "TextPowerInfoDescription",
                                        "fields": {
                                            "text": "Orbs of Power can be used to modify items in various ways. This is a short description of each orb and what they do, more detailed information can be found on the wiki.",
