                                "fields": {
                                    "rect": {
                                        "height": 450
                                    }
                                },
                                "children": [
                                    {
                                        "type": "TextBoxWidget",
                                        "name": "TextRenewalDescription",
                                        "fields": {
                                            "text": "An Orb of Renewal drops from Terror Zones and has a high drop rate from Heralds.\n\nWhen cubed with any armor or weapon, it returns that item to its normal rarity and superior-quality equivalent, similar to a Hel + El reroll that then makes the item superior.\n\nThis is useful for preparing a runeword base, or resetting an item before using it with Infusion or Conversion/Assemblage again.",
                                            "style": {
                                                "pointSize": 28,
                                                "spacing": {
                                                    "leading": 0.95,
                                                    "kerning": 0.95
                                                },
                                                "alignment": {
