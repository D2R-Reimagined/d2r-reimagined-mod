{
	/* Upon filename change UPDATE all "PanelManager", "GameplayOptionsPanel", "SettingsPanel" entries to filename without the "hd" ending */
	"type": "GameplayOptionsPanel", "name": "modinfo_tab7",
    "fields": {
        "priority": 9003,
        "rect": { "x": -865, "y": 400, "width": "$OptionsPanelWidth", "height": 1520 },
        "anchor": { "x": 0.5 },
        "applySettingsImmediately": false
    },
    "children": [
        {
                // Native OptionsPanel seeds the first focusable descendant of this accepted row.
                "type": "TableWidget", "name": "OptionsTable",
                "fields": {
                    "rect": { "width": "$OptionsPanelWidth", "height": 1520 },
                    "columns": [
                        { "width": "$OptionsPanelWidth", "alignment": { "h": "left", "v": "top" } }
                    ],
                    "rowHeight": 1520,
                    "cellPadding": { "left": 0, "top": 0, "right": 0, "bottom": 0 }
                },
                "children": [
                    {
                        "type": "TableRowWidget", "name": "ModInformationControlsRow",
                        "children": [
                            {
                                "type": "Widget", "name": "ModInformationControls",
                                "fields": {
                                    "rect": { "width": "$OptionsPanelWidth", "height": 1520 }
                                },
                                "children": [
                                    {
                                        "type": "ImageWidget", "name": "ScrollBarBackground",
                                        "fields": {
                                            "rect": "$OptionsScrollBarBackgroundRect",
                                            "anchor": { "x": 1.0 },
                                            "filename": "PauseMenu\\VerticalScroll"
                                        },
                                        "children": [
                                            {
                                                "type": "ScrollControllerWidget", "name": "ScrollController",
                                                "fields": {
                                                    "rect": "$OptionsScrollBarRect",
                                                    "anchor": { "x": 1.0 },
                                                    "upArrowFilepath": "FrontEnd\\HD\\Final\\FrontEnd_ScrollUpBtn",
                                                    "downArrowFilepath": "FrontEnd\\HD\\Final\\FrontEnd_ScrollDownBtn",
                                                    "barFilepath": "PauseMenu\\VerticalIndicator",
                                                    "viewName": "ScrollView",
                                                    "wheelScrollSound": "cursor_scroll_hd",
                                                    "buttonScrollSound": "cursor_scroll_hd",
                                                        "buttonScrollAmount": 90,
                                                        "focusIndicatorVisible": true,
                                                        "navigation": {
                                                            "left": { "name": "ColorBlindCalibration" },
                                                            "down": { "name": "ColorBlindCalibration" }
                                                        }
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        // Keep the actual Close button fixed below the information viewport.
                                        "type": "TableWidget", "name": "CloseTable",
                                        "fields": {
                                            "anchor": { "x": 0.5, "y": 0 },
                                            "rect": { "x": -250, "y": 1400 },
                                            "columns": [
                                                { "width": 500, "alignment": { "h": "center", "v": "center" } }
                                            ],
                                            "rowHeight": 120,
                                            "cellPadding": { "left": 0, "right": 0 }
                                        },
                                        "children": [
                                            {
                                                "type": "TableRowWidget", "name": "ModInformationCloseRow",
                                                "children": [
                                                    {
                                                        // This registered name admits the enclosing controls row; the scrollbar comes first for focus.
                                                        "type": "ButtonWidget", "name": "ColorBlindCalibration",
                                                        "fields": {
                                                            "filename": "FrontEnd\\HD\\Final\\FrontEnd_ButtonMed",
                                                            "onClickMessage": "PanelManager:ClosePanel:modinfo_aa",
                                                            "textString": "@strClose",
                                                            "hoveredFrame": 3,
                                                            "text/style": "$StyleFEButtonText",
                                                            "pointSize": "$MediumLargeFontSize",
                                                            "textColor": "$LightButtonTextColor",
                                                            "disabledFrame": 2,
                                                            "tooltipString": "@strClose",
                                                            "sound": "cursor_close_window_hd",
                                                            "acceptsEscKeyEverywhere": true,
                                                            "focusIndicatorFilename": "Controller/HoverImages/FrontEndButtonMed",
                                                            "navigation": {
                                                                "up": { "name": "ScrollController" }
                                                            }
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
        {
            "type": "ScrollViewWidget", "name": "ScrollView",
            "fields": {
                "rect": { "width": "$OptionsPanelWidth", "height": "$OptionsPanelHeight" },
                "scrollControllerName": "ScrollController"
            },
            "children": [
                {
                    "type": "TableWidget", "name": "InformationTable",
                    "fields": {
                        "columns": [ "$OptionsTableColumn1", "$OptionsTableColumn2" ],
                        "rowHeight": "$OptionsTableRowHeight"
                    },
                    "children": [
                        {
                            "type": "TableRowWidget", "name": "Upgrading",
                            "children": [
                                {
                                    "type": "TextBoxWidget", "name": "Upgrading",
                                    "fields": {
                                        "text": "TBD",
                                        "style": "$StyleSettingsTitle"
                                    },
                                    "children": [
                                        {
                                            "type": "ImageWidget", "name": "Divider",
                                            "fields": {
                                                "rect": "$OptionsDividerRect",
                                                "filename": "PauseMenu\\Divider"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "TableRowWidget", "name": "Row upgrading",
                            "children": [
                                {
                                    "type": "TextBoxWidget", "name": "Upgrading",
                                    "fields": {
                                        "text": "You were correct. IT WAS ME!",
                                        "style": "$StyleSettingsText"
                                    }
                                },
                                {
                                    "type": "disabled", "name": "Runes",
                                    "fields": {
                                        "rect": "$OptionsDropDownRect",
                                        "background/rect": "$OptionsDropDownBackgroundRect",
                                        "background/leftCapOffset": "$OptionsDropDownLeftCapOffset",
                                        "background/rightCapOffset": "$OptionsDropDownRightCapOffset",
                                        "pressedFrame": 1,
                                        "disabledFrame": 2,
                                        "hoveredFrame": 3,
                                        "focusIndicatorFilename": "$OptionsDropDownFocusIndicatorFilename",
                                        "states": [ "@Windowed", "@Fullscreen" ],
                                        "onUpdateMessage": "OptionsPanelMessage:SetWindowMode",
                                        "text/style": "$StyleSettingsCarousel",
                                        "textColor": "$FontColorLightGold",
                                        "tooltipString": "@OptionsMenuWindowModeTooltip",
                                        "tooltipStyle": {
                                            "showAfterDelay": true
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }

    ]
}
